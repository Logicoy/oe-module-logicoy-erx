{
    "name": "logicoy/oe-module-logicoy-erx",
    "description": "Connects an OpenEMR installation to the LogiCoy eRx network.",
    "license": "GPL-3.0-or-later",
    "type": "openemr-module",
    "keywords": [
        "openemr",
        "openemr-module",
        "erx",
        "e-prescribing",
        "logicoy"
    ],
    "homepage": "https://github.com/Logicoy/oe-module-logicoy-erx",
    "authors": [
        {
            "name": "LogiCoy",
            "homepage": "https://www.logicoy.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Logicoy/oe-module-logicoy-erx/issues",
        "source": "https://github.com/Logicoy/oe-module-logicoy-erx",
        "docs": "https://github.com/Logicoy/oe-module-logicoy-erx/blob/main/docs/INSTALL.md"
    },
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "LogiCoy\\ERx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LogiCoy\\ERx\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "extra": {
        "openemr": {
            "minimum-version": "7.0.0"
        }
    }
}
